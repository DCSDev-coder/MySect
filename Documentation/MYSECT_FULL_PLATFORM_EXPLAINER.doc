<table style="border-collapse:collapse; width:100%; margin:16px 0; font-family:Calibri, Arial, sans-serif;"><tr><th style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F1F5F9; font-weight:bold;"></th></tr><tr><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;"></td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;">1. CLIENT MOBILE APP</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;">&lt;-&gt;</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;">2. SECRETARY WORKSPACE</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;">&lt;-&gt;</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;">3. SUPER ADMIN</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;"></td></tr><tr><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;"></td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;">(Business Directors)</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;"></td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;">(Licensed Secretaries)</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;"></td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;">(HQ Console)</td><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;"></td></tr><tr><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;">• View company status         • Review client files         • Verify firms</td></tr><tr><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;">• Track SSM deadlines         • Approve / Query documents   • Transfer cos.</td></tr><tr><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;">• Upload documents            • Log SSM submissions         • Access control</td></tr><tr><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#F8FAFC;">• Contact secretary           • Manage practice clients     • Audit trail</td></tr><tr><td style="border:1px solid #CBD5E1; padding:8px 12px; text-align:left; font-size:10pt; background-color:#FFFFFF;"></td></tr></table>+---------------------------------------------------------------------------------+
